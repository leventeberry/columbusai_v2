# Columbus AI — local environment template
# Copy: cp .env.local.example .env.local
# Docker: docker compose --env-file .env.local -f infra/docker/compose.dev.yml ...
# Compose service blocks may override DATABASE_URL, internal webhooks, etc.

# Compose also sets NODE_ENV per service; used for host-side Prisma/scripts
NODE_ENV=development

POSTGRES_PASSWORD=columbus

DOMAIN=localhost

ACME_EMAIL=dev@localhost

CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3010,http://127.0.0.1:3010

VITE_API_URL=http://localhost:4000

NEXT_PUBLIC_API_URL=http://localhost:4000

VITE_ADMIN_URL=http://localhost:3002

# Compose overrides hostnames for containers; use localhost for host Prisma on laptop
DATABASE_URL=postgresql://columbus:columbus@localhost:5432/columbus

VECTOR_DATABASE_URL=postgresql://columbus:columbus@localhost:5433/columbus_vectors

REDIS_URL=redis://localhost:6379

# Optional jsonl fallback when DATABASE_URL unset
LEADS_PATH=

PORT=4000

OPENAI_API_KEY=sk-your-openai-key

OPENAI_MODEL=gpt-4o-mini

OPENAI_STORE=true

OPENAI_EMBED_MODEL=text-embedding-3-small

OPENAI_TIMEOUT_MS=30000

RATE_LIMIT_SCOPE=ip

RATE_LIMIT_MAX_REQUESTS=20

RATE_LIMIT_WINDOW_SECONDS=300

RETRIEVAL_K=5

VITE_CONTACT_EMAIL=contact@columbusai.tech

VITE_CHAT_TITLE="Chexi AI"

VITE_CHAT_WELCOME="I'm Chexi, your assistant. Ask me anything!"

VITE_CHEXI_AVATAR_URL=

VITE_BOOKING_LINK=https://calendar.app.google/qoVhywJhvCWaBSg69

NEXT_PUBLIC_CONTACT_FORM_URL=http://localhost:4000/api/contact

NEXT_PUBLIC_CONTACT_EMAIL=contact@columbusai.tech

NEXT_PUBLIC_CONTACT_PHONE=

NEXT_PUBLIC_CHAT_TITLE="Chexi AI"

NEXT_PUBLIC_CHAT_WELCOME="I'm Chexi, your assistant. Ask me anything!"

NEXT_PUBLIC_CHEXI_AVATAR_URL=

NEXT_PUBLIC_BOOKING_LINK=https://calendar.app.google/qoVhywJhvCWaBSg69

