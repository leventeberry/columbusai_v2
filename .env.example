# Repo root .env — used by Docker Compose when run from repo root (e.g. make up-dev, make up).
# Copy to .env and set values. Compose passes this file to api and web services; environment
# blocks in compose override DATABASE_URL, VECTOR_DATABASE_URL, REDIS_URL, NEXT_PUBLIC_API_URL for Docker.

# =============================================================================
# Docker Compose / infra (production — columbusai.tech VPS)
# =============================================================================
POSTGRES_PASSWORD=change-me-generate-strong-password
DOMAIN=columbusai.tech
ACME_EMAIL=contact@columbusai.tech

# =============================================================================
# Production URLs (Traefik / public)
# =============================================================================
CORS_ORIGIN=https://columbusai.tech,https://www.columbusai.tech
VITE_API_URL=https://api.columbusai.tech
NEXT_PUBLIC_API_URL=https://api.columbusai.tech

# =============================================================================
# Database (Prisma; required for /api/chat and messages)
# =============================================================================
# Local dev (Postgres on host):
# DATABASE_URL=postgresql://columbus:columbus@localhost:5432/columbus
# Docker Compose (compose overrides with postgres:5432):
DATABASE_URL=postgresql://columbus:columbus@postgres:5432/columbus

# =============================================================================
# Vector DB (optional; RAG in API)
# =============================================================================
# Local: postgresql://columbus:columbus@localhost:5433/columbus_vectors
# Docker: compose overrides with postgres:5432
VECTOR_DATABASE_URL=postgresql://columbus:columbus@postgres:5432/columbus_vectors

# =============================================================================
# Redis (optional; rate limiting in API when set)
# =============================================================================
# Local: redis://localhost:6379
# Docker: compose overrides with redis://redis:6379
REDIS_URL=redis://redis:6379

# =============================================================================
# API service (chat, health, messages)
# =============================================================================
PORT=4000

# OpenAI (required for /api/chat)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_STORE=true
OPENAI_EMBED_MODEL=text-embedding-3-small

# Rate limit (optional)
RATE_LIMIT_SCOPE=ip
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=300

# Retrieval / RAG (optional)
RETRIEVAL_K=5

# =============================================================================
# Marketing app (Vite / TanStack Start) — public (VITE_*)
# =============================================================================
VITE_CONTACT_EMAIL=contact@columbusai.tech
VITE_CHAT_TITLE="Chexi AI"
VITE_CHAT_WELCOME="I'm Chexi, your assistant. Ask me anything!"
# VITE_CHEXI_AVATAR_URL=
VITE_BOOKING_LINK=https://calendar.app.google/qoVhywJhvCWaBSg69

# =============================================================================
# Legacy web app (Next.js) — public (NEXT_PUBLIC_*)
# =============================================================================
NEXT_PUBLIC_CONTACT_FORM_URL=https://api.columbusai.tech/api/contact
NEXT_PUBLIC_CONTACT_EMAIL=contact@columbusai.tech
# NEXT_PUBLIC_CONTACT_PHONE=

NEXT_PUBLIC_CHAT_TITLE="Chexi AI"
NEXT_PUBLIC_CHAT_WELCOME="I'm Chexi, your assistant. Ask me anything!"
# NEXT_PUBLIC_CHEXI_AVATAR_URL=

NEXT_PUBLIC_BOOKING_LINK=https://calendar.app.google/qoVhywJhvCWaBSg69

# =============================================================================
# Webhooks / external (optional)
# =============================================================================
# Demo workflow: webhook path UUID f7ceff32-... | workflow id gEEYTVQe39iBRra3 (for n8n:pull/push only)
# Use /webhook/ when workflow is active; /webhook-test/ only during "Listen for test event" in n8n UI
N8N_DEMO_WEBHOOK_TEST_URL=http://localhost:5678/webhook/f7ceff32-3922-4ac8-a522-2b83995e5f04
N8N_DEMO_WEBHOOK_URL=http://localhost:5678/webhook/f7ceff32-3922-4ac8-a522-2b83995e5f04
N8N_WEBHOOK_URL=http://localhost:5678/webhook/f7ceff32-3922-4ac8-a522-2b83995e5f04
N8N_WEBHOOK_TEST_URL=http://localhost:5678/webhook-test/f7ceff32-3922-4ac8-a522-2b83995e5f04
BOOKING_LINK=https://calendar.app.google/qoVhywJhvCWaBSg69
UNSUBSCRIBE_WEBHOOK_URL=
UNSUBSCRIBE_WEBHOOK_TEST_URL=

# n8n service (Docker)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-strong-password
N8N_DEMO_WORKFLOW_ID=gEEYTVQe39iBRra3
# After n8n is live: create API key in https://n8n.columbusai.tech → Settings → API
N8N_API_URL=https://n8n.columbusai.tech
N8N_API_KEY=

GENERIC_TIMEZONE=America/New_York

# Hermes SDK runner
CURSOR_API_KEY=
# HERMES_SLACK_WEBHOOK_URL=
# HERMES_GITHUB_ISSUE_NUMBER=
# GITHUB_REPOSITORY=owner/repo
# GITHUB_TOKEN=

# Leads / admin (optional)
# LEADS_PATH=
# ADMIN_TOKEN=

# Admin dashboard (Supabase) — required for admin.columbusai.tech
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# From Supabase Dashboard → Project Settings → API → service_role (server-only, never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# =============================================================================
# Hostinger API (scripts/hostinger/* — dev laptop only, never commit token)
# =============================================================================
# Create token: https://hpanel.hostinger.com/profile/api
HOSTINGER_API_TOKEN=
HOSTINGER_VPS_IP=147.93.113.58
HOSTINGER_DOMAIN=columbusai.tech
HOSTINGER_SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
HOSTINGER_SSH_KEY_NAME=columbusai-deploy
HOSTINGER_GITHUB_COMPOSE_URL=https://github.com/leventeberry/columbusai_v2
HOSTINGER_DOCKER_PROJECT_NAME=columbusai-prod
HOSTINGER_FIREWALL_NAME=columbusai-prod

# =============================================================================
# Local dev overrides (uncomment when using make up-dev on laptop)
# =============================================================================
# CORS_ORIGIN=http://localhost:4000
# VITE_API_URL=http://localhost:4000
# NEXT_PUBLIC_API_URL=http://localhost:4000
# REDIS_URL=redis://localhost:6379
# N8N_API_URL=http://localhost:5678
# N8N_API_KEY=<local n8n API key — or prod key after deploy>
