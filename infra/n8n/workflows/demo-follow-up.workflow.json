{
  "name": "ColumbusAI_Demo_Follow_Up",
  "description": "Scheduled discovery-call follow-up: poll sales.leads, email by followup_count, update Postgres after each send.",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [-1200, 320],
      "id": "fu-schedule-001",
      "name": "Schedule Trigger"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n  l.id,\n  l.created_at,\n  l.updated_at,\n  l.fname,\n  l.lname,\n  l.email,\n  l.phone,\n  l.company,\n  l.role,\n  l.industry,\n  l.team_size,\n  l.what_automate,\n  l.budget,\n  l.timeline,\n  l.website,\n  l.status,\n  l.source,\n  l.notes,\n  l.summary,\n  l.priority,\n  l.confidence,\n  l.recommended_next_step,\n  l.followup_count\nFROM sales.leads l\nWHERE l.status = 'new'\n  AND l.source = 'demo_request'\n  AND l.followup_count < 2\n  AND l.next_followup_at IS NOT NULL\n  AND l.next_followup_at <= NOW()\nORDER BY l.next_followup_at ASC\nLIMIT 50;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-960, 320],
      "id": "fu-select-001",
      "name": "Select Due Leads",
      "credentials": {
        "postgres": {
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "options": {}
      },
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-720, 320],
      "id": "fu-loop-001",
      "name": "Loop Over Items"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "nl-id", "name": "id", "value": "={{ $json.id }}", "type": "string" },
            { "id": "nl-created", "name": "created_at", "value": "={{ $json.created_at }}", "type": "string" },
            { "id": "nl-updated", "name": "updated_at", "value": "={{ $json.updated_at }}", "type": "string" },
            { "id": "nl-fname", "name": "fname", "value": "={{ $json.fname }}", "type": "string" },
            { "id": "nl-lname", "name": "lname", "value": "={{ $json.lname }}", "type": "string" },
            { "id": "nl-email", "name": "email", "value": "={{ $json.email }}", "type": "string" },
            { "id": "nl-phone", "name": "phone", "value": "={{ $json.phone || '' }}", "type": "string" },
            { "id": "nl-company", "name": "company", "value": "={{ $json.company || '' }}", "type": "string" },
            { "id": "nl-role", "name": "role", "value": "={{ $json.role || '' }}", "type": "string" },
            { "id": "nl-industry", "name": "industry", "value": "={{ $json.industry || '' }}", "type": "string" },
            { "id": "nl-team", "name": "team_size", "value": "={{ $json.team_size || '' }}", "type": "string" },
            { "id": "nl-what", "name": "what_automate", "value": "={{ $json.what_automate }}", "type": "string" },
            { "id": "nl-budget", "name": "budget", "value": "={{ $json.budget || '' }}", "type": "string" },
            { "id": "nl-timeline", "name": "timeline", "value": "={{ $json.timeline || '' }}", "type": "string" },
            { "id": "nl-website", "name": "website", "value": "={{ $json.website || '' }}", "type": "string" },
            { "id": "nl-status", "name": "status", "value": "={{ $json.status }}", "type": "string" },
            { "id": "nl-source", "name": "source", "value": "={{ $json.source }}", "type": "string" },
            { "id": "nl-notes", "name": "notes", "value": "={{ $json.notes || '' }}", "type": "string" },
            { "id": "nl-summary", "name": "summary", "value": "={{ $json.summary || '' }}", "type": "string" },
            { "id": "nl-priority", "name": "priority", "value": "={{ $json.priority || '' }}", "type": "string" },
            { "id": "nl-confidence", "name": "confidence", "value": "={{ $json.confidence }}", "type": "number" },
            { "id": "nl-next", "name": "recommended_next_step", "value": "={{ $json.recommended_next_step || '' }}", "type": "string" },
            { "id": "nl-count", "name": "followup_count", "value": "={{ $json.followup_count }}", "type": "number" },
            {
              "id": "nl-contact",
              "name": "contact_name",
              "value": "={{ ($json.fname || '') + ' ' + ($json.lname || '') }}",
              "type": "string"
            },
            {
              "id": "nl-booking",
              "name": "booking_link",
              "value": "={{ $env.BOOKING_LINK || 'https://cal.com/columbus-ai/30min' }}",
              "type": "string"
            },
            {
              "id": "nl-wait2",
              "name": "followup_wait_2_minutes",
              "value": "={{ Number($env.FOLLOWUP_WAIT_2_MINUTES) || 2880 }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-480, 480],
      "id": "fu-normalize-001",
      "name": "Normalize Lead"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.followup_count }}",
                    "rightValue": 0,
                    "operator": { "type": "number", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 3
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.followup_count }}",
                    "rightValue": 1,
                    "operator": { "type": "number", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [-240, 480],
      "id": "fu-switch-001",
      "name": "Switch"
    },
    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Follow-up – Columbus AI</title>\n</head>\n<body style=\"margin:0; padding:0; background-color:#f4f4f4; font-family: Arial, Helvetica, sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#f4f4f4;\">\n    <tr>\n      <td align=\"center\" style=\"padding:24px 16px;\">\n        <table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px; width:100%; background-color:#ffffff;\">\n          <tr>\n            <td style=\"background-color:#2c3e50; color:#ffffff; padding:20px 32px;\">\n              <h1 style=\"margin:0; font-size:20px; font-weight:bold;\">Quick follow-up</h1>\n              <p style=\"margin:4px 0 0; font-size:12px; opacity:0.9;\">Columbus AI Automation Solutions, LLC</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:32px; color:#333333; font-size:16px; line-height:1.6;\">\n              <p style=\"margin-top:0;\">Hi {{ $('Normalize Lead').item.json.fname }},</p>\n              <p>Thank you again for reaching out to Columbus AI. We enjoyed reviewing your demo request for {{ $('Normalize Lead').item.json.company || 'your business' }}.</p>\n              <p>We would love to learn more about your automation goals and explore how we can help.</p>\n              <p style=\"padding:12px; background:#f8f9fa; border-left:4px solid #2c3e50; margin:16px 0;\">{{ $('Normalize Lead').item.json.what_automate }}</p>\n              <p>If you have not booked a discovery call yet, you can pick a time that works for you below.</p>\n              <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:24px 0;\">\n                <tr>\n                  <td style=\"border-radius:6px; background-color:#2c3e50;\">\n                    <a href=\"{{ $('Normalize Lead').item.json.booking_link }}\" style=\"display:inline-block; padding:12px 24px; color:#ffffff; text-decoration:none; font-weight:bold;\">Schedule a discovery call</a>\n                  </td>\n                </tr>\n              </table>\n              <p>We look forward to connecting with you.</p>\n              <p>Thank you,<br><strong>Columbus AI Automation Solutions, LLC</strong><br>Columbus, Ohio</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
      },
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [0, 360],
      "id": "fu-email1-html",
      "name": "Follow-Up 1 HTML"
    },
    {
      "parameters": {
        "fromEmail": "no-reply@columbusai.tech",
        "toEmail": "={{ $('Normalize Lead').item.json.email }}",
        "subject": "Quick follow-up on your Columbus AI demo request",
        "html": "={{ $json.html }}",
        "options": { "appendAttribution": false }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [240, 360],
      "id": "fu-email1-send",
      "name": "Follow-Up 1 Email",
      "credentials": {
        "smtp": {
          "id": "QdZmkAJuQO8vqx2e",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Closing the loop – Columbus AI</title>\n</head>\n<body style=\"margin:0; padding:0; background-color:#f4f4f4; font-family: Arial, Helvetica, sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#f4f4f4;\">\n    <tr>\n      <td align=\"center\" style=\"padding:24px 16px;\">\n        <table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px; width:100%; background-color:#ffffff;\">\n          <tr>\n            <td style=\"background-color:#2c3e50; color:#ffffff; padding:20px 32px;\">\n              <h1 style=\"margin:0; font-size:20px; font-weight:bold;\">Should we close the loop?</h1>\n              <p style=\"margin:4px 0 0; font-size:12px; opacity:0.9;\">Columbus AI Automation Solutions, LLC</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:32px; color:#333333; font-size:16px; line-height:1.6;\">\n              <p style=\"margin-top:0;\">Hi {{ $('Normalize Lead').item.json.fname }},</p>\n              <p>We wanted to check in one last time about your Columbus AI demo request. If timing is not right, no worries at all — we completely understand.</p>\n              <p>If you would still like to explore automation for your business, we would be happy to speak with you. You can schedule a discovery call whenever it suits you.</p>\n              <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:24px 0;\">\n                <tr>\n                  <td style=\"border-radius:6px; background-color:#2c3e50;\">\n                    <a href=\"{{ $('Normalize Lead').item.json.booking_link }}\" style=\"display:inline-block; padding:12px 24px; color:#ffffff; text-decoration:none; font-weight:bold;\">Schedule a discovery call</a>\n                  </td>\n                </tr>\n              </table>\n              <p>Either way, thank you for considering Columbus AI. We are here if you need us in the future.</p>\n              <p>Warm regards,<br><strong>Columbus AI Automation Solutions, LLC</strong><br>Columbus, Ohio</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
      },
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [0, 600],
      "id": "fu-email2-html",
      "name": "Final Follow-Up HTML"
    },
    {
      "parameters": {
        "fromEmail": "no-reply@columbusai.tech",
        "toEmail": "={{ $('Normalize Lead').item.json.email }}",
        "subject": "Should we close the loop?",
        "html": "={{ $json.html }}",
        "options": { "appendAttribution": false }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [240, 600],
      "id": "fu-email2-send",
      "name": "Final Follow-Up Email",
      "credentials": {
        "smtp": {
          "id": "QdZmkAJuQO8vqx2e",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE sales.leads\nSET\n  followup_count = followup_count + 1,\n  last_followup_at = NOW(),\n  next_followup_at = CASE\n    WHEN followup_count = 0\n      THEN NOW() + (INTERVAL '1 minute' * {{ $('Normalize Lead').item.json.followup_wait_2_minutes }})\n    ELSE NULL\n  END,\n  updated_at = NOW()\nWHERE id = '{{ $('Normalize Lead').item.json.id }}'::uuid\n  AND status = 'new'\n  AND followup_count = {{ $('Normalize Lead').item.json.followup_count }};",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [480, 480],
      "id": "fu-update-001",
      "name": "Mark Follow-Up Sent",
      "credentials": {
        "postgres": {
          "name": "Postgres account"
        }
      }
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO sales.lead_activity (lead_id, type, title, detail, metadata)\nVALUES (\n  '{{ $('Normalize Lead').item.json.id }}'::uuid,\n  'followup_sent',\n  'Follow-up email sent',\n  'Automated follow-up {{ $('Normalize Lead').item.json.followup_count + 1 }} of 2',\n  jsonb_build_object(\n    'source', 'n8n',\n    'followup_count', {{ $('Normalize Lead').item.json.followup_count + 1 }}\n  )\n);",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [720, 480],
      "id": "fu-activity-001",
      "name": "Record Follow-Up Activity",
      "credentials": {
        "postgres": {
          "name": "Postgres account"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [[{ "node": "Select Due Leads", "type": "main", "index": 0 }]]
    },
    "Select Due Leads": {
      "main": [[{ "node": "Loop Over Items", "type": "main", "index": 0 }]]
    },
    "Loop Over Items": {
      "main": [
        [],
        [{ "node": "Normalize Lead", "type": "main", "index": 0 }]
      ]
    },
    "Normalize Lead": {
      "main": [[{ "node": "Switch", "type": "main", "index": 0 }]]
    },
    "Switch": {
      "main": [
        [{ "node": "Follow-Up 1 HTML", "type": "main", "index": 0 }],
        [{ "node": "Final Follow-Up HTML", "type": "main", "index": 0 }]
      ]
    },
    "Follow-Up 1 HTML": {
      "main": [[{ "node": "Follow-Up 1 Email", "type": "main", "index": 0 }]]
    },
    "Follow-Up 1 Email": {
      "main": [[{ "node": "Mark Follow-Up Sent", "type": "main", "index": 0 }]]
    },
    "Final Follow-Up HTML": {
      "main": [[{ "node": "Final Follow-Up Email", "type": "main", "index": 0 }]]
    },
    "Final Follow-Up Email": {
      "main": [[{ "node": "Mark Follow-Up Sent", "type": "main", "index": 0 }]]
    },
    "Mark Follow-Up Sent": {
      "main": [[{ "node": "Record Follow-Up Activity", "type": "main", "index": 0 }]]
    },
    "Record Follow-Up Activity": {
      "main": [[{ "node": "Loop Over Items", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "pinData": {}
}
