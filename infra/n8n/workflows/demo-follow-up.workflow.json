      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [960, -120],
      "id": "fu-if2-001",
      "name": "IF Still New 2"
    },
    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Closing the loop – Columbus AI</title>\n</head>\n<body style=\"margin:0; padding:0; background-color:#f4f4f4; font-family: Arial, Helvetica, sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#f4f4f4;\">\n    <tr>\n      <td align=\"center\" style=\"padding:24px 16px;\">\n        <table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px; width:100%; background-color:#ffffff;\">\n          <tr>\n            <td style=\"background-color:#2c3e50; color:#ffffff; padding:20px 32px;\">\n              <h1 style=\"margin:0; font-size:20px; font-weight:bold;\">Should we close the loop?</h1>\n              <p style=\"margin:4px 0 0; font-size:12px; opacity:0.9;\">Columbus AI Automation Solutions, LLC</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:32px; color:#333333; font-size:16px; line-height:1.6;\">\n              <p style=\"margin-top:0;\">Hi {{ $('Normalize Lead').item.json.first_name }},</p>\n              <p>We wanted to check in one last time about your Columbus AI demo request. If timing is not right, no worries at all — we completely understand.</p>\n              <p>If you would still like to explore automation for your business, we would be happy to speak with you. You can schedule a discovery call whenever it suits you.</p>\n              <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:24px 0;\">\n                <tr>\n                  <td style=\"border-radius:6px; background-color:#2c3e50;\">\n                    <a href=\"{{ $('Normalize Lead').item.json.booking_link }}\" style=\"display:inline-block; padding:12px 24px; color:#ffffff; text-decoration:none; font-weight:bold;\">Schedule a discovery call</a>\n                  </td>\n                </tr>\n              </table>\n              <p>Either way, thank you for considering Columbus AI. We are here if you need us in the future.</p>\n              <p>Warm regards,<br><strong>Columbus AI Automation Solutions, LLC</strong><br>Columbus, Ohio</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
      },
      "type": "n8n-nodes-base.html",
      "typeVersion": 1.2,
      "position": [1200, -200],
      "id": "fu-email2-html",
      "name": "Final Follow-Up HTML"
    },
    {
      "parameters": {
        "fromEmail": "no-reply@columbusai.tech",
        "toEmail": "={{ $('Normalize Lead').item.json.email }}",
        "subject": "Should we close the loop?",
        "html": "={{ $json.html }}",
        "options": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1440, -200],
      "id": "fu-email2-send",
      "name": "Final Follow-Up Email",
      "credentials": {
        "smtp": {
          "id": "QdZmkAJuQO8vqx2e",
          "name": "SMTP account"
        }
      }
    }
  ],
