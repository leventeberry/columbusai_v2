        "operation": "executeQuery",
        "query": "SELECT\n  l.id,\n  l.created_at,\n  l.updated_at,\n  l.fname,\n  l.lname,\n  l.email,\n  l.phone,\n  l.company,\n  l.role,\n  l.industry,\n  l.team_size,\n  l.what_automate,\n  l.budget,\n  l.timeline,\n  l.website,\n  l.status,\n  l.source,\n  l.notes,\n  l.summary,\n  l.priority,\n  l.confidence,\n  l.recommended_next_step,\n  l.followup_count,\n  l.followup_template\nFROM sales.leads l\nWHERE l.status = 'new'\n  AND l.source = 'demo_request'\n  AND l.followup_template = '2day'\n  AND l.followup_count < 4\n  AND l.next_followup_at IS NOT NULL\n  AND l.next_followup_at <= NOW()\nORDER BY l.next_followup_at ASC\nLIMIT 50;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
