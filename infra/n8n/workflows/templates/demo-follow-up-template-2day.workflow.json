{
  "name": "ColumbusAI_Demo_Follow_Up_2_Day",
  "description": "TEMPLATE ONLY — import and activate one follow-up template per deployment. 2-Day Accelerated: emails on days 1, 2, 5, 7 from lead creation. Set DEFAULT_FOLLOWUP_TEMPLATE=2day on the API.",
