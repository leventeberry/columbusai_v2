      "parameters": {
        "operation": "executeQuery",
        "query": "=UPDATE sales.leads\nSET\n  followup_count = followup_count + 1,\n  last_followup_at = NOW(),\n  next_followup_at = CASE\n    WHEN followup_count = 0 THEN created_at + INTERVAL '2 days'\n    WHEN followup_count = 1 THEN created_at + INTERVAL '5 days'\n    WHEN followup_count = 2 THEN created_at + INTERVAL '7 days'\n    ELSE NULL\n  END,\n  updated_at = NOW()\nWHERE id = '{{ $('Normalize Lead').item.json.id }}'::uuid\n  AND status = 'new'\n  AND followup_template = '2day'\n  AND followup_count = {{ $('Normalize Lead').item.json.followup_count }};",
