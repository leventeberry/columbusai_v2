        "responses": {
          "values": [
            {
              "content": "=You are a senior sales qualification analyst for an AI automation agency.\n\nEvaluate the incoming demo lead and return ONE JSON object only. No markdown, no code fences, no extra text.\n\nRequired schema:\n{\n  \"priority\": \"High | Medium | Low\",\n  \"confidence\": \"High | Medium | Low\",\n  \"summary\": \"1-3 sentence summary of what they want to automate and fit for Columbus AI\",\n  \"automation_opportunities\": [\"specific opportunity 1\", \"specific opportunity 2\"],\n  \"reasoning\": \"Brief explanation of priority/confidence\",\n  \"recommended_next_action\": \"What the sales team should do next\"\n}\n\nPriority guidance:\n- High: budget $5k+, clear problem, decision maker, strong automation fit, urgency\n- Medium: budget $1k-$5k, somewhat clear use case, moderate urgency\n- Low: under $1k, vague problem, exploratory\n\nLead submission:\n{{ JSON.stringify($('Normalize Body').item.json) }}\n"
            }
          ]
        },
        "simplify": false,
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.1,
      "position": [-320, 0],
      "id": "ai-lead-analysis-node",
      "name": "AI Lead Analysis",
      "credentials": {
        "openAiApi": {
          "id": "jxREV56DUpYgg157",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const fallback = {\n  priority: 'Medium',\n  confidence: 'Low',\n  summary: 'The lead submitted a demo request, but the AI analysis could not be parsed.',\n  automation_opportunities: [],\n  reasoning: 'Fallback analysis due to parsing failure.',\n  recommended_next_action: 'Review manually and follow up.',\n};\n\nfunction extractText(item) {\n  const j = item.json || {};\n  return (\n    j.output?.[0]?.content?.[0]?.text ??\n    j.message?.content ??\n    j.text ??\n    ''\n  );\n}\n\nfunction parseAnalysis(raw) {\n  const text = String(raw || '').trim();\n  const cleaned = text\n    .replace(/^```json\\s*/i, '')\n    .replace(/^```\\s*/i, '')\n    .replace(/```\\s*$/i, '')\n    .trim();\n  if (!cleaned) return { ...fallback };\n  try {\n    const parsed = JSON.parse(cleaned);\n    if (!parsed || typeof parsed !== 'object') return { ...fallback };\n    return {\n      priority: parsed.priority ?? fallback.priority,\n      confidence: parsed.confidence ?? fallback.confidence,\n      summary: parsed.summary ?? fallback.summary,\n      automation_opportunities: Array.isArray(parsed.automation_opportunities)\n        ? parsed.automation_opportunities\n        : fallback.automation_opportunities,\n      reasoning: parsed.reasoning ?? fallback.reasoning,\n      recommended_next_action:\n        parsed.recommended_next_action ?? fallback.recommended_next_action,\n    };\n  } catch {\n    return { ...fallback };\n  }\n}\n\nconst normalize = $('Normalize Body').first().json;\n\nreturn $input.all().map((item) => {\n  const analysis = parseAnalysis(extractText(item));\n  const opportunities = analysis.automation_opportunities || [];\n  return {\n    json: {\n      ...normalize,\n      ...analysis,\n      analysis,\n      automation_opportunities_text: opportunities.join('; '),\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-96, 0],
      "id": "parse-ai-analysis-node",
      "name": "Parse AI Analysis"
    },
    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Demo Request – Columbus AI</title>\n</head>\n<body style=\"margin:0; padding:0; background-color:#f4f4f4; font-family: Arial, Helvetica, sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#f4f4f4;\">\n    <tr>\n      <td align=\"center\" style=\"padding: 24px 16px;\">\n        <table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px; width:100%; background-color:#ffffff;\">\n          <tr>\n            <td style=\"background-color:#2c3e50; color:#ffffff; padding: 20px 32px;\">\n              <h1 style=\"margin:0; font-size: 18px; font-weight: bold;\">New Demo Request</h1>\n              <p style=\"margin: 4px 0 0; font-size: 12px; opacity: 0.9;\">Columbus AI Automation Solutions, LLC</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 32px; color:#333333; font-size: 16px; line-height: 1.6;\">\n              <p style=\"margin:0 0 8px; font-weight: bold; font-size: 14px; color:#2c3e50;\">Lead details</p>\n              <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin: 0 0 24px; width:100%;\">\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold; width: 160px;\">Lead ID:</td><td>{{ $('Parse AI Analysis').item.json.lead_id }}</td></tr>\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold;\">Name:</td><td>{{ $('Parse AI Analysis').item.json.first_name }} {{ $('Parse AI Analysis').item.json.last_name }}</td></tr>\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold;\">Email:</td><td>{{ $('Parse AI Analysis').item.json.email }}</td></tr>\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold;\">Phone:</td><td>{{ $('Parse AI Analysis').item.json.phone }}</td></tr>\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold;\">Company:</td><td>{{ $('Parse AI Analysis').item.json.company }}</td></tr>\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold;\">Role:</td><td>{{ $('Parse AI Analysis').item.json.role }}</td></tr>\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold;\">Industry:</td><td>{{ $('Parse AI Analysis').item.json.industry }}</td></tr>\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold;\">Team Size:</td><td>{{ $('Parse AI Analysis').item.json.team_size }}</td></tr>\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold;\">Website:</td><td>{{ $('Parse AI Analysis').item.json.website }}</td></tr>\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold;\">Budget:</td><td>{{ $('Parse AI Analysis').item.json.budget }}</td></tr>\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold;\">Timeline:</td><td>{{ $('Parse AI Analysis').item.json.timeline }}</td></tr>\n              </table>\n              <p style=\"margin:0 0 8px; font-weight: bold; font-size: 14px; color:#2c3e50;\">AI analysis</p>\n              <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin: 0 0 24px; width:100%;\">\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold; width: 160px;\">Priority:</td><td>{{ $('Parse AI Analysis').item.json.priority }}</td></tr>\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold;\">Confidence:</td><td>{{ $('Parse AI Analysis').item.json.confidence }}</td></tr>\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold; vertical-align:top;\">AI Summary:</td><td>{{ $('Parse AI Analysis').item.json.summary }}</td></tr>\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold; vertical-align:top;\">Automation Opportunities:</td><td>{{ $('Parse AI Analysis').item.json.automation_opportunities_text }}</td></tr>\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold; vertical-align:top;\">Reasoning:</td><td>{{ $('Parse AI Analysis').item.json.reasoning }}</td></tr>\n                <tr><td style=\"padding: 2px 8px 2px 0; font-weight: bold; vertical-align:top;\">Recommended Next Action:</td><td>{{ $('Parse AI Analysis').item.json.recommended_next_action }}</td></tr>\n              </table>\n              <p style=\"margin:0 0 8px; font-weight: bold; font-size: 14px; color:#2c3e50;\">Original submission</p>\n              <p style=\"margin:0 0 8px;\"><strong>What to automate:</strong> {{ $('Parse AI Analysis').item.json.what_automate }}</p>\n              <p style=\"margin:0;\"><strong>Message:</strong> {{ $('Parse AI Analysis').item.json.message }}</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding: 0 32px 32px; color:#7f8c8d; font-size: 12px;\">\n              <p style=\"margin:0;\">Columbus AI Automation Solutions, LLC</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
      },
