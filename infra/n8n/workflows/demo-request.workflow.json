    {
      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>We've Received Your Request – Columbus AI</title>\n</head>\n<body style=\"margin:0; padding:0; background-color:#f4f4f4; font-family: Arial, Helvetica, sans-serif;\">\n  <table role=\"presentation\" width=\"100%\" cellspacing=\"0\" cellpadding=\"0\" style=\"background-color:#f4f4f4;\">\n    <tr>\n      <td align=\"center\" style=\"padding:24px 16px;\">\n        <table role=\"presentation\" width=\"600\" cellspacing=\"0\" cellpadding=\"0\" style=\"max-width:600px; width:100%; background-color:#ffffff;\">\n          <tr>\n            <td style=\"background-color:#2c3e50; color:#ffffff; padding:20px 32px;\">\n              <h1 style=\"margin:0; font-size:20px; font-weight:bold;\">Thank You For Reaching Out</h1>\n              <p style=\"margin:4px 0 0; font-size:12px; opacity:0.9;\">Columbus AI Automation Solutions, LLC</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:32px; color:#333333; font-size:16px; line-height:1.6;\">\n              <p style=\"margin-top:0;\">Hi {{ $('Normalize Body').item.json.first_name }},</p>\n              <p>Thank you for requesting a demo with Columbus AI.</p>\n              <p>We've received your information and are reviewing your automation goals. A member of our team will reach out shortly.</p>\n              <p>If you'd like to schedule a consultation immediately, use the button below.</p>\n              <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin:24px 0;\">\n                <tr>\n                  <td style=\"border-radius:6px; background-color:#2c3e50;\">\n                    <a href=\"{{ $('Normalize Body').item.json.booking_link }}\" style=\"display:inline-block; padding:12px 24px; color:#ffffff; text-decoration:none; font-weight:bold;\">Schedule a Consultation</a>\n                  </td>\n                </tr>\n              </table>\n              <p style=\"margin-top:32px; font-weight:bold; color:#2c3e50;\">Request Summary</p>\n              <table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"margin-bottom:24px; width:100%;\">\n                <tr><td style=\"padding:2px 8px 2px 0; font-weight:bold; width:120px;\">Company:</td><td>{{ $('Normalize Body').item.json.company }}</td></tr>\n                <tr><td style=\"padding:2px 8px 2px 0; font-weight:bold;\">Website:</td><td>{{ $('Normalize Body').item.json.website }}</td></tr>\n                <tr><td style=\"padding:2px 8px 2px 0; font-weight:bold;\">Submitted:</td><td>{{ $now }}</td></tr>\n              </table>\n              <p style=\"padding:12px; background:#f8f9fa; border-left:4px solid #2c3e50; margin:0;\">\"{{ $('Normalize Body').item.json.what_automate }}\"</p>\n              <p style=\"margin-top:24px;\">We look forward to learning more about your business.</p>\n              <p>Thank you,<br><strong>Columbus AI Automation Solutions, LLC</strong><br>Columbus, Ohio</p>\n            </td>\n          </tr>\n          <tr>\n            <td style=\"padding:0 32px 32px; color:#7f8c8d; font-size:12px;\">\n              <p style=\"margin:0;\">This email confirms we received your demo request.</p>\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>"
      },
