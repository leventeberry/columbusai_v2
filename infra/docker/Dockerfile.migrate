# Prisma migrate deploy — run from repo root context.
# docker build -f infra/docker/Dockerfile.migrate -t columbus-migrate .

FROM node:26-alpine
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN npm install -g corepack && corepack enable && corepack prepare pnpm@10.12.4 --activate

WORKDIR /app
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml .npmrc ./
COPY packages/db ./packages/db
ENV DATABASE_URL="postgresql://postgres:postgres@postgres:5432/columbusai?schema=public"
RUN pnpm install --frozen-lockfile --filter @columbusai/db... && pnpm --filter @columbusai/db generate

WORKDIR /app/packages/db
CMD ["pnpm", "exec", "prisma", "migrate", "deploy"]
