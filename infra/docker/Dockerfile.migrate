# Prisma migrate deploy — run from repo root context.
# docker build -f infra/docker/Dockerfile.migrate -t columbus-migrate .

FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/db ./packages/db
RUN npm ci --ignore-scripts && cd packages/db && npx prisma generate
WORKDIR /app/packages/db
CMD ["npx", "prisma", "migrate", "deploy"]
