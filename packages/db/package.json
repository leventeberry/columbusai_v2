{
  "name": "@columbusai/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && node scripts/build.mjs && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "typecheck": "tsc -p tsconfig.build.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "pg": "^8.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.16.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.4.2",
    "prisma": "^7.8.0",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=26"
  }
}
