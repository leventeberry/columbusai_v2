// --- sales schema: converted clients (CRM lifecycle, not automation.Client) ---

model SalesClient {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  opportunityId String           @unique @map("opportunity_id") @db.Uuid
  opportunity   SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  name    String
  status  SalesClientStatus @default(onboarding)
  owner   String?
  email   String
  company String  @default("")
  notes   String?

  portalClientId       String?                 @unique @map("portal_client_id")
  onboardingWorkItemId String?                 @map("onboarding_work_item_id")
  stackTemplateId      String?                 @map("stack_template_id")
  provisioningStatus   SalesProvisioningStatus @default(pending) @map("provisioning_status")
  provisioningError    String?                 @map("provisioning_error") @db.Text

  @@index([status])
  @@index([provisioningStatus])
  @@index([createdAt(sort: Desc)])
  @@map("clients")
  @@schema("sales")
}
