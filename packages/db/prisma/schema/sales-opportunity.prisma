// --- sales schema: opportunities ---

model SalesOpportunity {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  leadId String    @unique @map("lead_id") @db.Uuid
  lead   SalesLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  stage          SalesOpportunityStage @default(qualified)
  title          String
  company        String
  contactName    String    @map("contact_name")
  email          String
  estimatedValue Int?      @map("estimated_value")
  closeDate      DateTime? @map("close_date") @db.Date
  owner          String?
  notes          String?

  client SalesClient?

  @@index([stage])
  @@index([createdAt(sort: Desc)])
  @@map("opportunities")
  @@schema("sales")
}
