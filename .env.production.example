# Columbus AI — production environment template
# Copy: cp .env.production.example .env.production
# Docker: docker compose --env-file .env.production -f infra/docker/compose.prod.yml ...
# Compose service blocks may override DATABASE_URL, internal webhooks, etc.

# Compose also sets NODE_ENV per service; used for host-side Prisma/scripts
NODE_ENV=production

POSTGRES_PASSWORD=change-me-generate-strong-password

DOMAIN=columbusai.tech

ACME_EMAIL=contact@columbusai.tech

CORS_ORIGIN=https://columbusai.tech,https://www.columbusai.tech,https://admin.columbusai.tech,https://portal.columbusai.tech

VITE_API_URL=https://api.columbusai.tech

NEXT_PUBLIC_API_URL=https://api.columbusai.tech

VITE_ADMIN_URL=https://admin.columbusai.tech

# Compose overrides hostnames for containers; use localhost for host Prisma on laptop
DATABASE_URL=postgresql://columbus:change-me-generate-strong-password@postgres:5432/columbus

VECTOR_DATABASE_URL=postgresql://columbus:change-me-generate-strong-password@postgres:5432/columbus_vectors

REDIS_URL=redis://redis:6379

# Optional jsonl fallback when DATABASE_URL unset
LEADS_PATH=

PORT=4000

OPENAI_API_KEY=sk-your-openai-key

OPENAI_MODEL=gpt-4o-mini

OPENAI_STORE=true

OPENAI_EMBED_MODEL=text-embedding-3-small

OPENAI_TIMEOUT_MS=30000

RATE_LIMIT_SCOPE=ip

RATE_LIMIT_MAX_REQUESTS=20

RATE_LIMIT_WINDOW_SECONDS=300

RETRIEVAL_K=5

VITE_CONTACT_EMAIL=contact@columbusai.tech

VITE_CHAT_TITLE="Chexi AI"

VITE_CHAT_WELCOME="I'm Chexi, your Columbus AI assistant. Ask me anything!"

VITE_CHEXI_AVATAR_URL=

VITE_BOOKING_LINK=https://calendar.app.google/qoVhywJhvCWaBSg69

NEXT_PUBLIC_CONTACT_FORM_URL=https://api.columbusai.tech/api/contact

NEXT_PUBLIC_CONTACT_EMAIL=contact@columbusai.tech

NEXT_PUBLIC_CONTACT_PHONE=

NEXT_PUBLIC_CHAT_TITLE="Chexi AI"

NEXT_PUBLIC_CHAT_WELCOME="I'm Chexi, your Columbus AI assistant. Ask me anything!"

NEXT_PUBLIC_CHEXI_AVATAR_URL=

NEXT_PUBLIC_BOOKING_LINK=https://calendar.app.google/qoVhywJhvCWaBSg69

N8N_DEMO_WEBHOOK_TEST_URL=https://n8n.columbusai.tech/webhook/f7ceff32-3922-4ac8-a522-2b83995e5f04

N8N_DEMO_WEBHOOK_URL=https://n8n.columbusai.tech/webhook/f7ceff32-3922-4ac8-a522-2b83995e5f04

N8N_WEBHOOK_URL=https://n8n.columbusai.tech/webhook/f7ceff32-3922-4ac8-a522-2b83995e5f04

N8N_WEBHOOK_TEST_URL=https://n8n.columbusai.tech/webhook-test/f7ceff32-3922-4ac8-a522-2b83995e5f04

BOOKING_LINK=https://calendar.app.google/qoVhywJhvCWaBSg69

UNSUBSCRIBE_WEBHOOK_URL=

UNSUBSCRIBE_WEBHOOK_TEST_URL=

N8N_BASIC_AUTH_ACTIVE=true

N8N_BASIC_AUTH_USER=admin

N8N_BASIC_AUTH_PASSWORD=change-me-strong-password

# From pnpm n8n:list — not the webhook path UUID
N8N_DEMO_WORKFLOW_ID=gEEYTVQe39iBRra3

N8N_DEMO_FOLLOWUP_WORKFLOW_ID=

FOLLOWUP_WAIT_1_MINUTES=1440

FOLLOWUP_WAIT_2_MINUTES=2880

# Optional: 2day | 7day | 14day — multi-touch registry templates; unset = legacy 2-email flow
DEFAULT_FOLLOWUP_TEMPLATE=

N8N_API_URL=https://n8n.columbusai.tech

N8N_API_KEY=

GENERIC_TIMEZONE=America/New_York

# n8n container → API (compose sets http://api:4000)
COLUMBUS_API_URL=http://api:4000

# portal/admin server-side (compose overrides in Docker)
API_URL=http://api:4000

SALES_API_URL=http://api:4000

CURSOR_API_KEY=

HERMES_SLACK_WEBHOOK_URL=

HERMES_GITHUB_ISSUE_NUMBER=

GITHUB_REPOSITORY=

GITHUB_TOKEN=

ADMIN_API_TOKEN=

SESSION_SECRET=change-me-generate-a-long-random-string-at-least-32-chars

SESSION_COOKIE_NAME=columbus_session

SESSION_TTL_DAYS=14

COOKIE_DOMAIN=.columbusai.tech

SEED_ADMIN_EMAIL=admin@columbusai.com

SEED_ADMIN_PASSWORD=change-me-strong-password

DEV_MOCK_PORTAL=false

VITE_DEV_MOCK_PORTAL=false

# Laptop deploy scripts only — never commit
HOSTINGER_API_TOKEN=

HOSTINGER_VPS_IP=147.93.113.58

HOSTINGER_DOMAIN=columbusai.tech

HOSTINGER_SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub

HOSTINGER_SSH_KEY_NAME=columbusai-deploy

HOSTINGER_GITHUB_COMPOSE_URL=https://github.com/leventeberry/columbusai_v2

HOSTINGER_DOCKER_PROJECT_NAME=columbusai-prod

HOSTINGER_FIREWALL_NAME=columbusai-prod
